# Server
PORT=8080
NODE_ENV=development
# Comma-separated if you need more than one (e.g. staging + prod frontends).
# Must NOT contain "localhost" when NODE_ENV=production — the app refuses to boot if it does.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/keystone

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 random characters. The app refuses to boot in production without a real one.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- File uploads ---
# Local disk (used automatically if Cloudinary vars below are left blank) is fine
# for local development ONLY — most hosting platforms wipe local disk on every
# redeploy/restart, or run multiple instances with no shared disk, so uploaded
# photos will randomly disappear. Set the three Cloudinary vars before deploying.
UPLOAD_DIR=uploads

# Free account: https://cloudinary.com/users/register/free (no credit card required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional — app works fine with this off)
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Keystone <no-reply@keystone.example>

# --- AI Agent ---
# Provider wired: Google Gemini — genuinely free tier, no credit card required.
# Get a key at https://aistudio.google.com/apikey. See src/services/llmClient.js
# to swap providers (OpenAI, Groq, a local model via Ollama, etc.) — it's one small file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AGENT_ENABLED=true
